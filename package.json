{
  "name": "nivo",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev:all": "./start-dev.sh",
    "dev:all:down": "./stop-dev.sh",
    "dev:api": "bash -c 'set -a; [ -f .env ] && . .env; [ -f deployment/.env ] && . deployment/.env; set +a; cd apps/api && ./gradlew bootRun'",
    "api:dev": "bun run dev:api",
    "dev:db": "docker compose -f deployment/compose.dev.yaml up -d",
    "dev:db:down": "docker compose -f deployment/compose.dev.yaml down",
    "dev:db:logs": "docker compose -f deployment/compose.dev.yaml logs -f",
    "dev:web": "bun run --cwd apps/web start",
    "dev:design-system": "bun run --cwd libs/design-system storybook",
    "dev:build": "bun run --cwd libs/design-system build",
    "dev:tokens": "bun run --cwd libs/design-system generate:tokens",
    "docker:build": "docker compose -f deployment/compose.yaml -f deployment/compose.build.yaml build",
    "docker:up": "docker compose -f deployment/compose.yaml up -d",
    "e2e:env:up": "docker compose -f deployment/compose.e2e.yaml up -d",
    "e2e:env:down": "docker compose -f deployment/compose.e2e.yaml down",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:e2e:lightpanda": "bun run --cwd apps/web test:e2e:lightpanda",
    "test:e2e:chromium": "bun run --cwd apps/web test:e2e:chromium"
  },
  "workspaces": [
    "apps/web",
    "libs/design-system"
  ],
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
