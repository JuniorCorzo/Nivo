{
  "name": "nivo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "./dev.sh",
    "dev:all": "./dev.sh start",
    "dev:all:down": "./dev.sh stop",
    "dev:restart": "./dev.sh restart",
    "dev:status": "./dev.sh status",
    "dev:api": "bash -c 'set -a; [ -f .env ] && . .env; [ -f deployment/.env ] && . deployment/.env; set +a; cd apps/api && ./gradlew bootRun'",
    "api:dev": "pnpm run dev:api",
    "dev:db": "docker compose -f deployment/compose.dev.yaml up -d",
    "dev:db:down": "docker compose -f deployment/compose.dev.yaml down",
    "dev:db:logs": "docker compose -f deployment/compose.dev.yaml logs -f",
    "dev:web": "pnpm --filter web start",
    "dev:design-system": "pnpm --filter @nivo-sass/design-system storybook",
    "dev:build": "pnpm --filter @nivo-sass/design-system build",
    "dev:tokens": "pnpm --filter @nivo-sass/design-system generate:tokens",
    "docker:build": "docker compose -f deployment/compose.yaml -f deployment/compose.build.yaml build",
    "docker:up": "docker compose -f deployment/compose.yaml up -d",
    "e2e:env:up": "docker compose -f deployment/compose.e2e.yaml up -d",
    "e2e:env:down": "docker compose -f deployment/compose.e2e.yaml down",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:lightpanda": "pnpm --filter web test:e2e:lightpanda",
    "test:e2e:chromium": "pnpm --filter web test:e2e:chromium",
    "format:check": "oxfmt --check apps/web/src libs/design-system/src",
    "format:fix": "oxfmt --write apps/web/src libs/design-system/src",
    "format:api:check": "./apps/api/gradlew -p apps/api spotlessCheck",
    "format:api:fix": "./apps/api/gradlew -p apps/api spotlessApply",
    "format:all:check": "pnpm run format:api:check && pnpm run format:check",
    "format:all:fix": "pnpm run format:api:fix && pnpm run format:fix",
    "check:knip": "knip",
    "check:deps": "depcruise --config .dependency-cruiser.cjs apps/web/src libs/design-system/src",
    "check:spotbugs": "./apps/api/gradlew -p apps/api spotbugsMain",
    "check:secrets": "gitleaks protect --staged",
    "check:vuln": "trivy fs --severity HIGH,CRITICAL ."
  },
  "devDependencies": {
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.44.0",
    "oxfmt": "^0.66.0",
    "ultracite": "7.10.7"
  }
}
