# =============================================================================
# Nivo Environment Variables Configuration (.env.example)
# =============================================================================
# Copy this file to `.env` (or `deployment/.env`) and customize values.
#
# Generating Cryptographic Keys:
# -----------------------------------------------------------------------------
# 1. RSA Key Pair for JWT signing:
#    mkdir -p apps/api/applications/app-service/src/main/resources/keys
#    openssl genrsa -out apps/api/applications/app-service/src/main/resources/keys/private.pem 2048
#    openssl rsa -in apps/api/applications/app-service/src/main/resources/keys/private.pem -pubout -out apps/api/applications/app-service/src/main/resources/keys/public.pem
#
# 2. AES-256 Secret Key (Base64 encoded):
#    openssl rand -base64 32
# =============================================================================

# --- General & Platform ---
APP_VERSION=1.0.0
DOMAIN_NAME=localhost

# --- Database (PostGIS) ---
POSTGRES_DB=nivo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password
DB_PORT=5432
DB_URL=jdbc:postgresql://database:5432/nivo_db?currentSchema=nivo
DB_USERNAME=postgres
DB_PASSWORD=change_this_postgres_password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# --- Server & Ports ---
API_PORT=8080
WEB_PORT=80
SPRING_PROFILES_ACTIVE=prod

# --- Security & JWT ---
JWT_ISSUE=https://api.nivo.dev
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=604800
AES_SECRET_KEY=replace_with_openssl_rand_base64_32
RSA_KEY_ID=nivo-prod-key

# --- RSA Keys External Path (No rebuild required) ---
# Set to `file:/app/keys/public.pem` and mount ./deployment/keys:/app/keys
RSA_PUBLIC_KEY_LOCATION=classpath:keys/public.pem
RSA_PRIVATE_KEY_LOCATION=classpath:keys/private.pem
RSA_KEYS_DIR=./keys

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://nivo.dev,https://admin.nivo.dev

# --- External Integrations ---
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@nivo.dev

# --- Payment Gateway (ePayco / Gateway) ---
PAYMENT_PROVIDER_NAME=epayco
PAYMENT_PROVIDER_URL=https://apify.epayco.co
PAYMENT_PUBLIC_KEY=your_epayco_public_key
PAYMENT_PRIVATE_KEY=your_epayco_private_key
PAYMENT_EXPIRATION_TIME=25
PAYMENT_CONFIRMATION_URL=https://api.nivo.dev/api/payments/confirm
PAYMENT_CONFIRMATION_METHOD=POST

# --- Business / App Configuration ---
APP_CURRENCY=COP
APP_COMPANY_NAME=Nivo
APP_CTA_URL=https://nivo.dev/cta
APP_SUPPORT_URL=https://nivo.dev/support
APP_SOCIAL_URL=https://nivo.dev/social
APP_UNSUBSCRIBE_URL=https://nivo.dev/unsubscribe
APP_ADDRESS_COMPANY=123 Main St, City, Country

# --- Documentation & Swagger in Production ---
SWAGGER_ENABLED=false
SCALAR_ENABLED=false

# --- Resource Limits (Docker Compose) ---
WEB_CPU_LIMIT=0.50
WEB_MEM_LIMIT=256M
WEB_CPU_RESERVATION=0.10
WEB_MEM_RESERVATION=64M

API_CPU_LIMIT=2.0
API_MEM_LIMIT=1024M
API_CPU_RESERVATION=0.25
API_MEM_RESERVATION=512M

DB_CPU_LIMIT=2.0
DB_MEM_LIMIT=1024M
DB_CPU_RESERVATION=0.25
DB_MEM_RESERVATION=256M
